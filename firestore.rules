rules_version = '2';

// Regras de seguranca do Firestore do Rankio.
//
// Leitura: ABERTA — qualquer pessoa pode ver ranking, esportes, jogos e chaves.
// Escrita: somente OPERADOR LOGADO (Firebase Auth) — criar/editar times,
//          esportes, jogos, lancar pontos, finalizar, salvar sorteio etc.
//
// Como aplicar: Firebase Console > Firestore Database > Regras (cole e publique),
// ou `firebase deploy --only firestore:rules` (precisa do firebase-tools logado).
//
// Pre-requisito: habilitar Authentication > Sign-in method > E-mail/senha e
// criar a conta do operador em Authentication > Users.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
