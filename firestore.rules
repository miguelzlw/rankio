rules_version = '2';

// Regras de seguranca do Firestore do Rankio.
//
// ESTADO ATUAL: o app usa uma "senha de operador" no proprio app (client-side)
// pra liberar edicao. Isso NAO chega ao banco — entao, em termos de Firestore,
// leitura e escrita ficam abertas. O "cadeado" eh no app, nao no banco.
//
// >>> PROTECAO FORTE (opcional): se um dia voce ativar o Firebase Authentication
// (Console > Authentication > Email/senha) e criar a conta do operador, troque o
// bloco abaixo por:
//
//   match /{document=**} {
//     allow read: if true;
//     allow write: if request.auth != null;
//   }
//
// ... e o app passa a exigir login real pra escrever no banco.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
